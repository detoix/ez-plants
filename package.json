{
  "name": "@detoix/ez-plants",
  "author": "Daniel Greenheck",
  "version": "1.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/detoix/ez-plants.git"
  },
  "homepage": "https://github.com/detoix/ez-plants",
  "bugs": {
    "url": "https://github.com/detoix/ez-plants/issues"
  },
  "type": "module",
  "main": "build/ez-plants.umd.js",
  "module": "build/ez-plants.es.js",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./build/ez-plants.es.js",
      "require": "./build/ez-plants.umd.js"
    },
    "./react": {
      "types": "./build/react/index.d.ts",
      "import": "./build/react/index.js"
    },
    "./field": {
      "types": "./types/field.d.ts",
      "import": "./build/field/index.js"
    },
    "./field/webgpu": {
      "types": "./types/field.webgpu.d.ts",
      "import": "./build/field/webgpu.js"
    }
  },
  "files": [
    "build",
    "src",
    "types",
    "LICENSE",
    "package.json",
    "README.md"
  ],
  "types": "./types/index.d.ts",
  "scripts": {
    "dev": "vite --config vite.app.config.js",
    "test": "node --test",
    "build": "npm run build:lib && npm run build:react && npm run build:field && npm run build:app",
    "build:app": "vite build --config vite.app.config.js",
    "build:lib": "vite build --config vite.lib.config.js && tsc -p tsconfig.json",
    "build:watch": "vite build --config vite.lib.config.js --watch",
    "app": "npm run build:lib && vite --config vite.app.config.js",
    "preview": "vite preview",
    "build:react": "vite build --config vite.react.config.js && tsc -p tsconfig.react.json",
    "build:field": "vite build --config vite.field.config.js",
    "typecheck": "tsc -p tsconfig.react.json --noEmit",
    "plant:add": "node scripts/add-plant.mjs"
  },
  "devDependencies": {
    "@react-three/fiber": "^9.7.0",
    "@detoix/instanced-mesh": "file:vendor/detoix-instanced-mesh-0.3.16-webgpu.0.tgz",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "0.185.0",
    "playwright": "^1.62.1",
    "prettier": "3.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "0.185.0",
    "typescript": "5.6.2",
    "vite": "^5.0.0",
    "vite-plugin-static-copy": "^1.0.5"
  },
  "peerDependencies": {
    "@react-three/fiber": ">=8",
    "@detoix/instanced-mesh": "0.3.16-webgpu.0",
    "react": ">=18",
    "three": ">=0.185.0 <0.186.0"
  },
  "keywords": [
    "threejs",
    "three-js",
    "react-three-fiber",
    "procedural",
    "generation",
    "tree",
    "garden",
    "phenology",
    "hydrangea",
    "thuja",
    "arborvitae",
    "smaragd",
    "conifer",
    "prunus",
    "cherry-laurel",
    "laurel",
    "rotundifolia",
    "evergreen",
    "forsythia",
    "lavender",
    "blackcurrant",
    "miscanthus",
    "pennisetum",
    "echinacea",
    "coneflower",
    "fountain-grass",
    "ornamental-grass",
    "subshrub"
  ],
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@react-three/fiber": {
      "optional": true
    },
    "@detoix/instanced-mesh": {
      "optional": true
    }
  }
}
